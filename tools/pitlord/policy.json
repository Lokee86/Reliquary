{
  "version": 1,
  "includes": [
    "../../.standards/policies/architecture-core.json",
    "../../.standards/policies/documentation-core.json",
    "semantic.json"
  ],
  "areas": [
    {
      "id": "container",
      "description": "REL/PHY physical format and container primitives",
      "paths": [
        "crates/reliquary-container"
      ]
    },
    {
      "id": "switchboard",
      "description": "Provider transport, endpoints, credentials, and configuration",
      "paths": [
        "crates/reliquary-switchboard"
      ]
    },
    {
      "id": "chronos",
      "description": "Pure temporal parsing and bounded decision validation",
      "paths": [
        "crates/reliquary-chronos"
      ]
    },
    {
      "id": "archive-store",
      "description": "Archive and Echo durable state",
      "paths": [
        "crates/reliquary-archive"
      ]
    },
    {
      "id": "memory-store",
      "description": "Memory bodies, lineage, revisions, and tombstones",
      "paths": [
        "crates/reliquary-memory-core"
      ]
    },
    {
      "id": "graph-store",
      "description": "Graph topology, Community projections, and history",
      "paths": [
        "crates/reliquary-graph"
      ]
    },
    {
