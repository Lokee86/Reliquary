{
  "version": 1,
  "includes": [
    "../../../engineering-standards/policies/pitlord/architecture-core.json",
    "semantic.json"
  ],
  "rules": [
    {
      "id": "legacy-workspace-metadata-forbidden",
      "type": "forbid_content",
      "include_paths": [
        "src/**/*.rs"
      ],
      "literal": "WorkspaceMetadata",
      "message": "Reliquary must not recreate deleted generic workspace metadata authority.",
      "exclude_paths": [
        "src/facade/migration.rs"
      ]
    },
    {
      "id": "legacy-workspace-type-forbidden",
      "type": "forbid_content",
      "include_paths": [
        "src/**/*.rs"
      ],
      "literal": "workspace_type",
      "message": "Reliquary must not recreate generic persisted workspace type authority.",
      "exclude_paths": [
        "src/facade/migration.rs"
      ]
    },
    {
      "id": "external-source-no-native-append",
      "type": "forbid_content",
      "include_paths": [
        "src/external_source/**/*.rs"
      ],
      "exclude_paths": [
        "src/external_source/tests.rs"
      ],
      "literal": ".append_node(",
      "message": "External canonical transcript bodies and IDs must not become native Archive history."
    },
    {
      "id": "external-source-no-native-fragments",
      "type": "forbid_content",
      "include_paths": [
        "src/external_source/**/*.rs"
      ],
      "exclude_paths": [
        "src/external_source/tests.rs"
      ],
      "literal": ".materialize_path_fragments(",
      "message": "External canonical transcript bodies and IDs must not become native Archive history."
    },
    {
      "id": "external-source-no-native-episode",
      "type": "forbid_content",
      "include_paths": [
        "src/external_source/**/*.rs"
      ],
      "exclude_paths": [
        "src/external_source/tests.rs"
      ],
      "literal": "Episode {",
      "message": "External canonical transcript bodies and IDs must not become native Archive history."
    }
  ]
}
