{
  "version": 1,
  "areas": [
    {
      "id": "compact-codec",
      "description": "Pure field-change and known-mask value mechanics; no semantic owner, clock, persistence or publication authority",
      "paths": [
        "src/compact_delta.rs",
        "src/historical_timeline.rs",
        "src/pure_codec"
      ]
    },
    {
      "id": "freshness",
      "description": "REL-local deterministic relevance scores, decay, event batches and bounded graph propagation; independent of semantic Memory revisions",
      "paths": [
        "src/freshness",
        "src/freshness_storage.rs",
        "src/freshness_storage_tests.rs",
        "src/freshness_dream_journal.rs",
        "src/freshness_due.rs"
      ]
    },
    {
      "id": "container",
      "description": "Physical REL/PHY container mechanics and file-global ordering",
      "paths": [
        "src/container"
      ]
    },
    {
      "id": "archive",
      "description": "Source history, conversations, fragments, episodes, attachments, Echo, and repository correlations",
      "paths": [
        "src/archive"
      ]
    },
    {
      "id": "memory",
      "description": "Authoritative Memory records, revisions, provenance metadata, and Memory-local state",
      "paths": [
        "src/memory"
      ]
    },
    {
      "id": "retrieval",
      "description": "Lexical/semantic retrieval, vector bindings, packed vectors, compatibility profiles, and generations",
      "paths": [
        "src/retrieval"
      ]
    },
    {
      "id": "semantic-graph",
      "description": "Typed semantic graph authority, Communities, and graph traversal",
      "paths": [
        "src/semantic_graph"
      ]
    },
    {
      "id": "perception",
      "description": "Durable Entity state, admission, candidate routing, resolution state, and resolver processing",
      "paths": [
        "src/perception"
      ]
    },
    {
      "id": "chronos",
      "description": "Shared deterministic/inference-assisted temporal semantics",
      "paths": [
        "src/chronos"
      ]
    },
    {
      "id": "ego",
      "description": "Owner-local Identity, Personality, Anchor, and synthesis persistence",
      "paths": [
        "src/ego"
      ]
    },
    {
      "id": "runtime-inference",
      "description": "Insomnia, Dream, provider endpoints, long-lived runtime host, and background inference composition",
      "paths": [
        "src/runtime_inference"
      ]
    },
    {
      "id": "config-security",
      "description": "Machine-local configuration, credentials, encryption, and master-key persistence",
      "paths": [
        "src/config_security"
      ]
    },
    {
      "id": "facade",
      "description": "Public Cva/Reliquary/Phylactery composition, migration, reconciliation, and cross-owner facade methods",
      "paths": [
        "src/facade",
        "src/lib.rs",
        "src/tombstone_import_history_characterization_tests.rs",
        "src/source_identity.rs"
      ]
    },
    {
      "id": "context-engine",
      "description": "Provider-neutral context messages, evidence rendering and compaction policy",
      "paths": [
        "src/context_engine.rs",
        "src/context_engine"
      ]
    },
    {
      "id": "project-environment",
      "description": "Lore/Git project repository bootstrap, identity validation and attachment ingestion",
      "paths": [
        "src/project_environment.rs",
        "src/project_environment",
        "src/project_environment_git_tests.rs",
        "src/project_environment_lore_tests.rs",
        "src/project_environment_tests.rs"
      ]
    },
    {
      "id": "staleness",
      "description": "Pure owner-qualified typed clocks and review-threshold arithmetic; no persistence or scoring authority",
      "paths": [
        "src/staleness"
      ]
    },
    {
      "id": "native-import",
      "description": "Versioned historical normalization, exclusive Cva import composition and completion coordination; Archive retains source/receipt authority and Freshness owns settlement replay",
      "paths": [
        "src/imports"
      ]
    },
    {
      "id": "external-source",
      "description": "Host canonical reference contracts and derived index; external semantic publication composes MemoryStore without creating Archive source history",
      "paths": [
        "src/external_source",
        "src/external_index"
      ]
    },
    {
      "id": "history-rewrite",
      "description": "Intentional fresh-history selection, closure, emission and generation lineage",
      "paths": [
        "src/rewrite.rs",
        "src/rewrite",
        "src/rewrite_lineage.rs"
      ]
    },
    {
      "id": "history",
      "description": "Read-only reconstruction and proof of validated historical owner state; no semantic writes or policy coordination",
      "paths": [
        "src/history"
      ]
    },
    {
      "id": "maintenance",
      "description": "Explicit owner maintenance policy for pruning, reclamation, repair, reconciliation, copy and rewrite",
      "paths": [
        "src/maintenance"
      ]
    },
    {
      "id": "owner-lifecycle",
      "description": "Physical owner open, replay, validation, publication and narrow lifecycle transport capabilities",
      "paths": [
        "src/owner_lifecycle.rs",
        "src/owner_lifecycle"
      ]
    }
  ],
