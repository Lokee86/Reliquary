+fn read_source_manifest(repo: &Path, manifest: &Path) -> Result<Vec<PathBuf>> {
+    let bytes = fs::read(manifest)
+        .with_context(|| format!("cannot read source manifest {}", manifest.display()))?;
+    let manifest_hash = format!("{:x}", Sha256::digest(&bytes));
+    let value: Value = serde_json::from_slice(&bytes).context("invalid source manifest JSON")?;
+    anyhow::ensure!(
+        value.get("schema").and_then(Value::as_str)
+            == Some("reliquary.production-source-manifest.v1"),
+        "unsupported production source manifest schema"
+    );
+    let files = value
+        .get("files")
+        .and_then(Value::as_array)
+        .context("source manifest files must be an array")?;
+    anyhow::ensure!(!files.is_empty(), "production source manifest is empty");
+    anyhow::ensure!(
+        value.get("file_count").and_then(Value::as_u64) == Some(files.len() as u64),
+        "source manifest file count does not match its entries"
+    );
+
+    let canonical_repo = repo
+        .canonicalize()
+        .with_context(|| format!("cannot resolve repository {}", repo.display()))?;
+    let mut paths = Vec::with_capacity(files.len());
+    let mut seen = BTreeSet::new();
+    let mut normalized_paths = Vec::with_capacity(files.len());
+    for entry in files {
+        let relative = entry
+            .get("path")
+            .and_then(Value::as_str)
+            .context("source manifest entry path must be a string")?;
+        let expected_hash = entry
+            .get("sha256")
+            .and_then(Value::as_str)
+            .context("source manifest entry sha256 must be a string")?;
+        let relative_path = Path::new(relative);
+        anyhow::ensure!(
+            !relative_path.is_absolute()
+                && relative_path.starts_with("src")
+                && relative_path.extension().and_then(|value| value.to_str()) == Some("rs")
+                && relative_path
+                    .components()
+                    .all(|part| matches!(part, std::path::Component::Normal(_))),
+            "invalid production source path: {relative}"
+        );
+        let normalized = relative.replace('\\', "/");
+        anyhow::ensure!(
+            seen.insert(normalized.clone()),
+            "duplicate source path: {normalized}"
+        );
+        normalized_paths.push(normalized);
+        let path = repo.join(relative_path);
+        let canonical = path
+            .canonicalize()
+            .with_context(|| format!("missing production source file: {relative}"))?;
+        anyhow::ensure!(
+            canonical.starts_with(&canonical_repo),
+            "source path escapes repository: {relative}"
+        );
+        let source = fs::read(&canonical)?;
+        let actual_hash = format!("{:x}", Sha256::digest(&source));
+        anyhow::ensure!(
+            actual_hash == expected_hash,
+            "source hash changed: {relative}"
+        );
+        paths.push(path);
+    }
+    normalized_paths.sort();
+    let tree_hash = format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(&normalized_paths)?)
+    );
+    anyhow::ensure!(
+        value.get("module_tree_sha256").and_then(Value::as_str) == Some(tree_hash.as_str()),
+        "source manifest module-tree digest does not match its entries"
+    );
+    crate::orchestrator::progress(&format!(
+        "accepted production source manifest sha256={manifest_hash} files={}",
+        paths.len()
+    ));
+    Ok(paths)
+}
