  "contracts": [
    "Construct insomnia main endpoint, embedding endpoint with configured batching, and Chronos endpoint in the existing order.",
    "Attach metadata, entity enrichment, and optional ownership endpoints in their existing order and only when configured/present.",
    "Preserve embedding probe query mode, one-item input, vector count, first-vector dimensions, and normalization.",
    "Preserve public ConfiguredRuntime API signatures, facade report construction, error string mapping, and Cva/Phylactery offline file composition."
  ],
